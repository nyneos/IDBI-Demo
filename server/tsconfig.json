{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": [
    "cmd/**/*.ts",
    "config/**/*.ts",
    "controllers/**/*.ts",
    "services/**/*.ts",
    "models/**/*.ts",
    "repositories/**/*.ts",
    "routes/**/*.ts",
    "middleware/**/*.ts",
    "database/**/*.ts",
    "utils/**/*.ts"
  ]
}
